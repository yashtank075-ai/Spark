  "scripts": {
    "test": "node -e \"process.env.NODE_ENV='test'; process.env.DB_TEST_NAME='spark_test';\" && jest --runInBand --forceExit",
    "test:isolated": "node -e \"process.env.NODE_ENV='test'; process.env.DB_TEST_NAME='spark_test'; const { spawnSync } = require('child_process'); const res = spawnSync('npx', ['jest', '--runInBand', '--forceExit'], { stdio: 'inherit', shell: true, env: { ...process.env, NODE_ENV: 'test', DB_TEST_NAME: 'spark_test' } }); process.exit(res.status);\"",
    "dev": "nodemon server.js",
    "db:migrate": "node services/migrationRunner.js up",
    "db:migrate:undo": "node services/migrationRunner.js down",
    "db:seed:test": "node scripts/seed-section-704-test-data.js",
    "db:seed:games": "node scripts/seed-game-catalog.js",
    "db:seed:admin": "node scripts/seed-admin-dev.js"
  },
