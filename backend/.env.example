DB_NAME=spark_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432
JWT_ACCESS_SECRET=your_jwt_secret
OTP_HASH_SECRET=your_otp_secret
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPS=5
ACCESS_TOKEN_MINUTES=15

# Media Storage Configuration
# Set STORAGE_PROVIDER to "local", "cloudflare_r2", "aws_s3", or "cloudinary". Default is "local" if empty.
STORAGE_PROVIDER=local
STORAGE_CREDENTIALS=your_storage_credentials_or_keys

# Cloudflare R2 Configuration (required if STORAGE_PROVIDER=cloudflare_r2)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_cloudflare_r2_bucket_name
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional: Custom public domain or Cloudflare workers/R2 public dev URL for public media delivery
R2_PUBLIC_BASE_URL=https://media.yourdomain.com
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# Base URL for public API and media streaming when media is served via backend (e.g. ngrok HTTPS URL for mobile app testing)
PUBLIC_API_BASE_URL=https://your-ngrok-or-backend-domain.com

# Admin Portal Configuration
ADMIN_JWT_SECRET=your_admin_jwt_secret_different_from_user_secret
ADMIN_TOKEN_MINUTES=60
DEV_ADMIN_PASSWORD=your_dev_only_admin_password

# Face Verification Configuration (InsightFace)
FACE_MATCH_THRESHOLD=0.40
PYTHON_PATH=python
FACE_VERIFICATION_TIMEOUT_MS=20000

